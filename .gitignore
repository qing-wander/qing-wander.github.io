.DS_Store
worker/.deploy-url
worker/.wrangler/
node_modules/

# 本地 wrangler 缓存（wrangler d1 execute --local / pages dev 产生）
.wrangler/

# 部署日志（本地排查用，不入库）
worker/*.log

# WorkBuddy 项目本地数据（记忆/技能等，不入库）
.workbuddy/

# 本地密钥（DEVICE_HASH_PEPPER / WALL_ADMIN_TOKEN 等，绝不入库）
.secrets.local

# 后台本地变量（ADMIN_PASSWORD / ADMIN_SESSION_SECRET 等，绝不入库）
admin/.dev.vars

# 角色构建中间产物（Mixamo 原始 FBX、Blender 未压缩 GLB；站点只加载 assets/skins/models/*.glb）
assets/character-views/model/*/mixamo-downloads/
assets/character-views/model/*/FemaleRigged_raw.glb
assets/character-views/model/*/FemaleRigged_opt.glb

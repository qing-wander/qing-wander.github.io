---
// /login —— React 版登录页（M1）。逻辑见 src/features/login/LoginApp.tsx。
// 样式自旧 login.html 的 <style> 原样搬迁（类名零改动）；
// 登录页 CSP 允许本页自足加载（旧版同理：不能依赖守卫后的 /admin/assets/*）。
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2314110E'/%3E%3Ctext x='16' y='22' font-size='16' fill='%23F3EEE2' text-anchor='middle' font-family='monospace'%3ES%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F3EEE2" />
    <title>登录 · 后台</title>
    <link rel="icon" href={favicon} />
  </head>
  <body>
    <div id="root"></div>
    <script>
      import '../features/login/main';
    </script>
  </body>
</html>

<style is:global>
  /* ── 自旧 login.html 原样搬迁（M1：视觉零变化）── */
  :root {
    --paper: #F3EEE2; --paper-2: #FBF8F1; --ink: #14110E; --ink-2: #4A423A;
    --line: #D8CFBF; --accent: #E8501E; --ok: #1F7A4C;
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    --sans: "Noto Sans SC", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    min-height: 100vh; display: grid; place-items: center; padding: 24px;
    background: repeating-linear-gradient(90deg, rgba(20, 17, 14, .035) 0 1px, transparent 1px 6px), var(--paper);
    color: var(--ink); font-family: var(--sans); font-size: 14px; line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .card { width: 100%; max-width: 400px; background: var(--paper-2); border: 2px solid var(--ink); padding: 28px 26px; box-shadow: 8px 8px 0 rgba(20, 17, 14, .12); }
  .tag { margin: 0 0 14px; font-family: var(--mono); font-size: 11px; letter-spacing: .18em; color: var(--accent); }
  h1 { font-size: 25px; margin: 0 0 6px; letter-spacing: -.02em; }
  .hint { color: var(--ink-2); font-size: 13px; margin: 0 0 22px; }
  .btn { display: block; width: 100%; padding: 11px 14px; border: 2px solid var(--ink); background: transparent; color: var(--ink); font: inherit; font-weight: 600; text-align: center; text-decoration: none; cursor: pointer; }
  .btn:hover { background: var(--ink); color: var(--paper); }
  .btn:disabled, .btn[aria-disabled="true"] { opacity: .45; cursor: not-allowed; background: transparent; color: var(--ink); }
  .btn-wx { background: #07C160; border-color: #07C160; color: #fff; }
  .btn-wx:hover { background: #06AD56; border-color: #06AD56; color: #fff; }
  .btn-mini { background: #07C160; border-color: #07C160; color: #fff; margin-top: 10px; }
  .btn-mini:hover { background: #06AD56; border-color: #06AD56; color: #fff; }
  .btn-solid { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-solid:hover { background: var(--ink); border-color: var(--ink); }
  .btn-sm { width: auto; padding: 6px 12px; font-size: 12px; font-weight: 500; }
  .divider { display: flex; align-items: center; gap: 10px; margin: 20px 0; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; color: var(--ink-2); }
  .divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  label { display: block; }
  .field-label { display: block; margin-bottom: 6px; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--ink-2); }
  input { width: 100%; padding: 11px 12px; background: #fff; border: 2px solid var(--ink); font: inherit; color: var(--ink); outline: none; }
  input:focus { box-shadow: 0 0 0 3px rgba(232, 80, 30, .22); }
  input[inputmode="numeric"] { font-family: var(--mono); font-size: 20px; letter-spacing: .28em; text-align: center; }
  .row { display: flex; gap: 8px; align-items: stretch; }
  .row .btn { margin-top: 14px; }
  .row .btn-sm { flex: none; }
  .msg { font-size: 13px; margin: 12px 0 0; min-height: 20px; color: var(--accent); display: block; }
  .msg.is-ok { color: var(--ok); }
  .msg code { font-family: var(--mono); font-size: 12px; background: #fff; border: 1px solid var(--line); padding: 1px 5px; }
  .id-row { display: block; margin-top: 6px; word-break: break-all; }
  .foot { margin: 18px 0 0; font-size: 13px; color: var(--ink-2); display: flex; justify-content: space-between; gap: 10px; }
  .foot a { color: var(--ink-2); text-decoration: none; border-bottom: 1px solid var(--line); }
  .note { font-size: 12px; color: var(--ink-2); margin: 10px 0 0; }
  .modal { position: fixed; inset: 0; z-index: 20; background: rgba(20, 17, 14, .62); display: grid; place-items: center; padding: 24px; }
  .qr-card { width: 100%; max-width: 340px; background: var(--paper-2); border: 2px solid var(--ink); padding: 22px 20px; box-shadow: 8px 8px 0 rgba(20, 17, 14, .18); }
  .qr-card h2 { font-size: 19px; margin: 0 0 4px; }
  .qr-card .hint { margin: 0 0 14px; }
  .qr-wrap { width: 220px; height: 220px; margin: 0 auto; border: 1px solid var(--line); background: #fff; display: grid; place-items: center; }
  .qr-wrap img { width: 100%; height: 100%; object-fit: contain; }
  .qr-card .msg { text-align: center; min-height: 44px; word-break: break-all; }
  .qr-card .btn { margin-top: 8px; }
</style>

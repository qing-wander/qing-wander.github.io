.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 56rpx;
  box-sizing: border-box;
}
.mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #07C160;
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 128rpx;
  text-align: center;
  margin-bottom: 40rpx;
}
.mark.wait { background: #D8CFBF; }
.title { font-size: 40rpx; font-weight: 800; margin-bottom: 16rpx; }
.desc { font-size: 26rpx; color: #4A423A; text-align: center; line-height: 1.7; word-break: break-all; }
.btn {
  margin-top: 48rpx;
  width: 320rpx;
  background: #14110E;
  color: #F3EEE2;
  font-size: 28rpx;
}
.foot {
  position: absolute;
  bottom: 60rpx;
  font-size: 22rpx;
  color: #7A7168;
}

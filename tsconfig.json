{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "dist-react", "node_modules", "scripts", "functions", "admin", "worker", "tests/e2e"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // 决策点 D2：strict 全开 —— 一次性支付类型成本（docs/react-refactor-plan.md §10）
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@data/*": ["data/*"]
    }
  }
}
